{
  "name": "siklamen-bilgi-oyunu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/*.test.mjs\"",
    "test:seed": "node --test test/seed.test.mjs",
    "test:visual": "node scripts/shot.mjs http://localhost:5173/ shots",
    "test:canli": "node scripts/canli-shot.mjs http://localhost:5173 shots",
    "worker:check": "wrangler deploy -c worker/wrangler.toml --env=\"\" --dry-run --outdir .wrangler/dry-run",
    "worker:deploy": "wrangler deploy -c worker/wrangler.toml --env=\"\"",
    "worker:deploy:preview": "wrangler deploy -c worker/wrangler.toml --env preview",
    "worker:logs": "wrangler tail -c worker/wrangler.toml --env=\"\"",
    "pages:deploy": "wrangler pages deploy dist --project-name nasodren5 --branch main",
    "db:seed-sql": "node scripts/seed-migration.mjs",
    "db:import": "node scripts/supabase-import.mjs",
    "scan:bundle": "node scripts/scan-bundle.mjs",
    "db:seed-check": "node scripts/seed-migration.mjs --check",
    "worker:check:preview": "wrangler deploy -c worker/wrangler.toml --env preview --dry-run --outdir .wrangler/dry-run-preview"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "pixi.js": "^8.22.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@types/node": "^26.6.6",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.168.0"
  },
  "engines": {
    "node": ">=22.6"
  }
}
