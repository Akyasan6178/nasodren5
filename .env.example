# Ortam değişkenleri (yalnızca adlar ve açıklamalar; gerçek değer YAZMAYIN).
# Sunucu bu dosyayı okumaz: değerleri barındırma platformunun ortam değişkeni / secret ayarıyla verin.
# Ayrıntılar: README.md → "Production".

# Zorunlu (production). En az 12 karakter, benzersiz ve güçlü bir parola.
# Eksik, boş, kısa ya da bilinen bir varsayılan ise sunucu başlamaz.
ADMIN_PASSWORD=

# İsteğe bağlı. Varsayılan 8080.
PORT=

# Önündeki güvenilir ters vekil sayısı (0–5). Vekil yoksa boş bırakın ya da 0 verin.
TRUST_PROXY=

# Hız sınırları (IP başına). Boş bırakılırsa varsayılanlar kullanılır.
ADMIN_LOGIN_MAX_FAILURES=
ADMIN_LOGIN_WINDOW_SECONDS=
ROOM_CREATE_MAX=
ROOM_CREATE_WINDOW_SECONDS=
GAME_START_MAX=
GAME_START_WINDOW_SECONDS=

# Yalnızca derleme sırasında: "yerel" yazılırsa sunucusuz statik mod derlenir (cevap anahtarı tarayıcıya iner).
VITE_VERI_MODU=
